{
  "manifest_version": 3,
  "name": "Browser Ad Killer · 浏览器广告杀手",
  "short_name": "AdKiller",
  "version": "0.1.0",
  "description": "面向 Edge / Chrome 的轻量广告拦截：网络层 DNR 拦截 + 搜索引擎（Google/百度/Bing/搜狗/360）推广结果净化，配置可导出同步到夸克、QQ 等 Chromium 浏览器。",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Browser Ad Killer",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "builtin",
        "enabled": true,
        "path": "rulesets/builtin.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.com.hk/*",
        "*://*.google.co.jp/*"
      ],
      "js": ["src/content/search-cleaner.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.baidu.com/*",
        "*://*.baiducontent.com/*"
      ],
      "js": ["src/content/search-cleaner.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.bing.com/*",
        "*://cn.bing.com/*"
      ],
      "js": ["src/content/search-cleaner.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.sogou.com/*",
        "*://*.so.com/*"
      ],
      "js": ["src/content/search-cleaner.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
